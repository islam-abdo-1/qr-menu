// Prisma Schema — QR Menu (Supabase PostgreSQL / Vercel + Cloudflare)

generator client {
  provider       = "prisma-client-js"
  driverAdapters = true // يعمل على runtime Workers (Cloudflare Pages) عبر adapter-pg
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// مطعم داخل المنصة — كل مطعم له منيو وإعدادات وطلبات مستقلة
model Restaurant {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  ownerId   String     @unique // Supabase Auth user id
  staffPin  String     @unique // كود دخول الموظفين (4 أرقام، فريد)
  pinFailedAttempts Int @default(0) // محاولات الكود الخاطئة (قفل ضد التخمين)
  pinLockedUntil    DateTime? // مدة القفل بعد تكرار المحاولات الخاطئة
  blocked   Boolean    @default(false) // حظر مؤقت من لوحة المالك — يوقف لوحة الأدمن والموظفين (المنيو العام يعمل)
  trialEndsAt   DateTime? // نهاية الأسبوع المجاني — بعده يلزم الاشتراك (الفترة المجانية لأول 7 أيام)
  paidUntil     DateTime? // نهاية الاشتراك المدفوع الحالي — مستوفى الاشتراك ما دام في المستقبل
  billingExempt Boolean   @default(false) // مستثنى نهائيًا من الفوترة — لا يُحظر ولا يُحذف ولا يلزمه دفع
  createdAt DateTime   @default(now())
  settings  Setting?
  categories Category[]
  menuItems  MenuItem[]
  orders     Order[]
  orderItems OrderItem[]  // Items from all orders for analytics
  tables     Table[]
  dayStats   DayStat[]
  staff      Staff[]
  payments  Payment[]

  @@index([ownerId])
}

/// إعداد عام للمنصة (key/value) — يُعدَّل من تطبيق لوحة المالك بلا إعادة نشر
model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @default("")
}

/// دفعة اشتراك — تُنشأ عند دفع خطة شهرية/سنوية (بوابة Paymob عند تفعيلها)
model Payment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amount       Float
  plan         String     @default("monthly") // monthly | annual
  method       String     @default("manual") // fawry | vodafone-cash | card | manual
  paymobRef    String?    @unique // مرجع العملية من بوابة الدفع
  status       String     @default("paid") // pending | paid | failed
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt(sort: Desc)])
}

/// سجل إجراءات المالك — أرشيف من فعل ماذا ومتى (حظر/حذف/تعديل)
model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  targetType String
  targetName String
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

/// محاولات دخول لوحة المالك — أساس قفل التخمين (5 فاشلة خلال 15 دقيقة = قفل)
model OwnerLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt(sort: Desc)])
}

model Setting {
  id               Int        @id @default(autoincrement())
  restaurantId     String     @unique
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantName   String     @default("مطعمي")
  currency         String     @default("EGP")
  themePrimary     String     @default("#C84C21")
  logoUrl          String?    @default("")
  logoPublicId     String?    // Cloudinary public ID for easy deletion
  logoWidth        Int?
  logoHeight       Int?
  logoSizeKB       Int?
  deliveryEnabled  Boolean    @default(true) // تفعيل/تعطيل استقبال طلبات التوصيل من المنيو
  createdAt        DateTime   @default(now())
}

model Category {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  items        MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id                 String            @id @default(uuid())
  restaurantId       String
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  price              Float
  discountPercentage Int? // 0-100 — null/0 = لا خصم
  imageUrl           String?
  imagePublicId      String?          // Cloudinary public ID for easy deletion
  imageWidth         Int? // بيانات تعريف الصورة المضغوطة — تُحسب أثناء الرفع (URL فقط يبقى في العمود أعلاه)
  imageHeight        Int?
  imageSizeKB        Int?
  imageBlurDataURL   String? // Base64 blur placeholder (20x20 webp) for LQIP
  isAvailable        Boolean           @default(true)
  sizeMode           String            @default("letters") // letters (S/M/L) أو weight (ربع/نص/كيلو + مخصص) — وضع واحد فقط لكل صنف
  categoryId         String            // FK لـ Category — cuid text (matches Category.id)
  category           Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  sizes              MenuItemSize[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([imagePublicId])
}

/// مقاس محدد لصنف (حرفي S/M/L أو وزني مثل «ربع كيلو»/«كيلو ونص») بسعر خاص به — يُستخدم عند الطلب
model MenuItemSize {
  id         String   @id @default(uuid())
  sizeCode   String // S | M | L | ربع كيلو | نص كيلو | كيلو | وزن مخصص
  price      Float
  menuItemId String   // FK لـ MenuItem — cuid text (matches MenuItem.id)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([menuItemId, sizeCode])
  @@index([menuItemId])
}

/// طلب — يمكن تقديمه بدون حساب (الزبون قد يربطه بحسابه لاحقًا)
model Order {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number       Int
  type         String // dine-in | delivery
  customerName String
  tableNo      String?
  phone        String?
  address      String?
  notes        String?
  status       String      @default("new") // new | preparing | done
  staffName    String? // اسم الموظف الذي تعامل مع الطلب — يظهر في لوحة الإدارة فقط
  completedAt  DateTime? // وقت التسليم (يُملأ عند وصول الحالة إلى done)
  total        Float
  cartNonce    String?     @db.VarChar(64) // معرف تفرد من العميل — يعيد الطلب نفسه عند إعادة الإرسال (مضاد للتكرار/السباق)
  createdAt    DateTime    @default(now())
  items        OrderItem[]

  @@unique([restaurantId, number])
  // POSTGRES يسمح بتعدد القيم NULL — الطلبات بلا nonce (المسار القديم) لا تتقيد أبدًا
  @@unique([restaurantId, cartNonce])
  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([restaurantId, status, createdAt(sort: Desc)])
}

/// عدّاد صارم لطلبات المطعم خلال نافذة زمنية — يُحدَّث ذريًا (row-lock) لمنع تجاوز الحد بالإرسال المتوازي
model OrderWindow {
  restaurantId String
  windowStart  DateTime @db.Timestamptz(3) // بداية النافذة الحالية (مضاعفات 5 دقائق)
  count        Int      @default(0)

  @@id([restaurantId, windowStart])
}

/// إجماليات يومية لكل مطعم — تُحدَّث لحظة إنشاء الطلب (مصدر التقارير)
model DayStat {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date // يوم المطعم (بتوقيت القاهرة)
  revenue      Float      @default(0)
  orders       Int        @default(0)
  dineIn       Int        @default(0)
  delivery     Int        @default(0)
  scans        Int        @default(0) // فتحات رابط المنيو (عدّاد QR) — تُحدَّث لحظة فتح العميل للصفحة

  @@unique([restaurantId, date])
}

/// موظف مطعم — الدخول باسمه مع الكود السري المشترك للمطعم
model Staff {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

/// طاولة داخل المطعم — لكل طاولة رابط QR خاص يملأ رقم الطاولة تلقائيًا
model Table {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number       Int
  reserved     Boolean    @default(false) // متاح/محجوز
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, number])
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @db.Uuid // FK لـ Order — uuid مطابق لنوع المفتاح المرجعي (SEC-003)
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId        String? // مرجع الصنف الأصلي (لتقارير الأكثر مبيعًا) — بلا FK حسب التصميم
  name          String
  sizeCode      String? // S/M/L/XL عند طلب صنف بمقاس — يظهر للموظف والأدمن
  price         Float // السعر النهائي المحسوب (بعد الخصم إن وُجد)
  qty           Int
  restaurantId  String  // للفهارس المركبة والاستعلامات السريعة
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([itemId])
  @@index([itemId, orderId])
  @@index([restaurantId, itemId, createdAt(sort: Desc)])
}










